{% doc %}
  Renders the first product image matching a gallery marker, with a manual and
  featured-image fallback. Gallery markers are removed from the image alt text.

  @param {product} product - Product to search
  @param {string} [marker] - Gallery marker, for example [gallery:lifestyle]
  @param {string} [markers] - Comma-separated marker priority list
  @param {object} [fallback_image] - Optional manually selected image
  @param {number} [index] - Zero-based matching image index
  @param {boolean} [use_fallbacks] - Uses the manual and featured image fallbacks
  @param {string} [class] - Image class
  @param {string} [sizes] - Responsive sizes value
  @param {string} [loading] - Loading mode, eager by default
  @param {string} [fetchpriority] - Fetch priority
  @param {string} [alt] - Fallback alt text
{% enddoc %}

{% liquid
  assign requested_index = index | default: 0 | plus: 0
  assign selected_image = blank
  assign product_fallback_image = blank
  assign marker_list = markers | default: marker | default: '' | split: ','

  if product != blank
    for marker_value in marker_list
      assign matching_index = 0
      assign first_matching_image = blank
      assign marker_downcase = marker_value | strip | downcase

      if marker_downcase != blank
        for media in product.media
          assign media_alt_downcase = media.alt | default: '' | downcase
          if media.media_type == 'image' and media_alt_downcase contains marker_downcase
            if first_matching_image == blank
              assign first_matching_image = media.preview_image
            endif
            if matching_index == requested_index
              assign selected_image = media.preview_image
              break
            endif
            assign matching_index = matching_index | plus: 1
          endif
        endfor
        if selected_image == blank
          assign selected_image = first_matching_image
        endif
      endif
      if selected_image != blank
        break
      endif
    endfor
  endif

  if product != blank
    assign fallback_index = 0
    for media in product.media
      if media.media_type == 'image'
        if fallback_index == requested_index
          assign product_fallback_image = media.preview_image
          break
        endif
        assign fallback_index = fallback_index | plus: 1
      endif
    endfor
  endif

  if use_fallbacks != false
    assign selected_image = selected_image | default: fallback_image | default: product_fallback_image | default: product.featured_image
  endif
  assign image_loading = loading | default: 'eager'
  assign image_sizes = sizes | default: '(min-width: 990px) 50vw, 100vw'
  assign image_class = class | default: 'product-story__image'
  assign image_alt = selected_image.alt | default: alt | default: product.title

  assign cleaned_alt = ''
  assign alt_segments = image_alt | split: '['
  for alt_segment in alt_segments
    assign alt_segment_downcase = alt_segment | downcase
    assign is_gallery_marker = false
    if alt_segment_downcase contains 'gallery:hero]'
      assign is_gallery_marker = true
    elsif alt_segment_downcase contains 'gallery:lifestyle]'
      assign is_gallery_marker = true
    elsif alt_segment_downcase contains 'gallery:detail]'
      assign is_gallery_marker = true
    elsif alt_segment_downcase contains 'gallery:feature]'
      assign is_gallery_marker = true
    elsif alt_segment_downcase contains 'gallery:video]'
      assign is_gallery_marker = true
    endif

    if is_gallery_marker
      assign alt_remainder = alt_segment | split: ']' | last
      assign cleaned_alt = cleaned_alt | append: alt_remainder
    else
      unless forloop.first
        assign cleaned_alt = cleaned_alt | append: '['
      endunless
      assign cleaned_alt = cleaned_alt | append: alt_segment
    endif
  endfor
  assign cleaned_alt = cleaned_alt | strip
%}

{% if selected_image != blank %}
  {{
    selected_image
    | image_url: width: 2400
    | image_tag:
      widths: '480, 720, 960, 1200, 1600, 2000, 2400',
      sizes: image_sizes,
      loading: image_loading,
      fetchpriority: fetchpriority,
      alt: cleaned_alt,
      class: image_class
  }}
{% endif %}
