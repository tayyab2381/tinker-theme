            {% endif %}

            {% if section.settings.show_apple_pay %}
              <svg class="ai-footer-payment-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 32"><rect width="48" height="32" rx="4" fill="#000"/><path fill="#FFF" d="M10.3 11.8c-.3.4-.8.7-1.3.6-.1-.5.1-1 .4-1.3.3-.4.8-.7 1.2-.7.1.5 0 1-.3 1.4zm.3.5c-.7 0-1.2.4-1.5.4s-.8-.4-1.4-.4c-.7 0-1.4.4-1.7 1.1-.8 1.3-.2 3.3.5 4.4.4.5.8 1.1 1.4 1.1.5 0 .7-.4 1.4-.4.6 0 .8.4 1.4.4.6 0 1-.5 1.4-1.1.4-.6.6-1.2.6-1.2s-1.2-.5-1.2-1.8c0-1.1.9-1.6.9-1.6s-.5-.8-1.3-.8l-.5-.1zm5.9-1.7v7.2h1.1v-2.5h1.5c1.4 0 2.3-.9 2.3-2.3s-.9-2.4-2.3-2.4h-2.6zm1.1 1h1.4c1 0 1.5.5 1.5 1.4s-.5 1.4-1.5 1.4h-1.4v-2.8zm5.5 6.3c.7 0 1.3-.4 1.6-1h.1v.9h1v-4.2c0-.9-.7-1.5-1.9-1.5-1.1 0-1.9.6-2 1.4h1c.1-.4.4-.6.9-.6.6 0 .9.3.9.8v.4l-1.2.1c-1.1.1-1.7.5-1.7 1.3 0 .8.6 1.4 1.5 1.4h-.2zm.3-.9c-.5 0-.9-.3-.9-.7 0-.4.3-.6.9-.7l1.1-.1v.4c0 .6-.5 1.1-1.1 1.1zm3.3 2.6c1.1 0 1.6-.4 2.1-1.6l2-5.6h-1.1l-1.4 4.5h-.1l-1.4-4.5h-1.2l1.9 5.3-.1.3c-.2.5-.4.7-.8.7-.1 0-.2 0-.3-.1v.9c.1.1.3.1.4.1z"/></svg>
            {% endif %}

            {% if section.settings.show_google_pay %}
              <svg class="ai-footer-payment-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 32"><rect width="48" height="32" rx="4" fill="#FFF"/><path fill="#5F6368" d="M22.3 16.7v3.6h-1.4v-9.1h3.7c.9 0 1.7.3 2.3.9.6.6.9 1.4.9 2.3s-.3 1.7-.9 2.3c-.6.6-1.4.9-2.3.9h-2.3v.1zm0-5.1v3.7h2.4c.6 0 1.1-.2 1.5-.6.4-.4.6-.9.6-1.5s-.2-1.1-.6-1.5c-.4-.4-.9-.6-1.5-.6h-2.4v.5zm9.3 1.5c1.1 0 2 .4 2.7 1.1.7.7 1.1 1.7 1.1 2.8v5h-1.3v-1.1h-.1c-.6.9-1.4 1.3-2.4 1.3-.9 0-1.6-.3-2.2-.8-.6-.5-.9-1.2-.9-2s.3-1.5.9-2c.6-.5 1.3-.8 2.2-.8.8 0 1.5.2 2 .6v-.4c0-.6-.2-1.1-.7-1.5-.4-.4-1-.6-1.6-.6-.9 0-1.6.4-2.1 1.1l-1.2-.7c.7-1.1 1.8-1.6 3.2-1.6l.4-.4zm-2 5.8c0 .4.2.8.5 1.1.4.3.8.5 1.3.5.7 0 1.3-.3 1.8-.8.5-.5.8-1.1.8-1.8-.4-.4-1.1-.6-1.9-.6-.6 0-1.1.2-1.5.5-.4.3-.6.7-.6 1.2l-.4-.1zm9.8-9.7h1.4v13.1h-1.4V9.2z"/><path fill="#4285F4" d="M17.5 14.1c0-.4 0-.8-.1-1.2H12v2.3h3.1c-.1.7-.6 1.4-1.2 1.8v1.5h1.9c1.1-1 1.7-2.5 1.7-4.4z"/><path fill="#34A853" d="M12 18.9c1.6 0 3-.5 4-1.4l-1.9-1.5c-.5.4-1.2.6-2.1.6-1.6 0-3-1.1-3.5-2.5H6.6v1.5c1 2 3 3.3 5.4 3.3z"/><path fill="#FBBC04" d="M8.5 14.1c-.3-.7-.3-1.5 0-2.2v-1.5H6.6c-1 2-1 4.3 0 6.3l1.9-1.5v-1.1z"/><path fill="#EA4335" d="M12 10.4c.9 0 1.7.3 2.3.9l1.7-1.7C15 8.6 13.6 8 12 8c-2.4 0-4.4 1.3-5.4 3.3l1.9 1.5c.5-1.4 1.9-2.5 3.5-2.5v.1z"/></svg>
            {% endif %}

            {% if section.settings.show_paypal %}
              <svg class="ai-footer-payment-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 32"><path fill="#003087" d="M18.7 9.5h-4.1c-.3 0-.5.2-.6.5l-1.7 10.8c0 .2.1.4.3.4h1.9c.3 0 .5-.2.6-.5l.5-2.9c.1-.3.3-.5.6-.5h1.4c2.8 0 4.5-1.4 4.9-4.1.2-1.2 0-2.1-.6-2.8-.6-.7-1.7-1.1-3.2-1.1v.2zm.5 4c-.2 1.4-1.3 1.4-2.4 1.4h-.6l.4-2.6c0-.2.2-.3.4-.3h.3c.8 0 1.6 0 2 .5.2.3.3.7.2 1.2l-.3-.2zm11.5 0h-1.9c-.2 0-.4.1-.4.3l-.1.6-.2-.3c-.5-.7-1.6-1-2.7-1-2.5 0-4.7 1.9-5.1 4.6-.2 1.4.1 2.7.8 3.6.7.8 1.6 1.2 2.7 1.2 1.9 0 3-1.2 3-1.2l-.1.6c0 .2.1.4.3.4h1.7c.3 0 .5-.2.6-.5l1.1-6.9c0-.2-.1-.4-.3-.4h-.4zm-2.6 4c-.2 1.3-1.2 2.2-2.5 2.2-.6 0-1.1-.2-1.5-.6-.3-.4-.5-1-.4-1.6.2-1.3 1.2-2.2 2.5-2.2.6 0 1.1.2 1.4.6.4.4.5 1 .5 1.6z"/><path fill="#009CDE" d="M35.9 9.5h-1.9c-.2 0-.4.1-.5.3l-2.9 4.3-1.2-4.1c-.1-.3-.3-.5-.6-.5h-1.9c-.2 0-.4.2-.3.5l2.3 6.8-2.2 3.1c-.2.2 0 .6.3.6h1.9c.2 0 .4-.1.5-.3l7-10.1c.2-.3 0-.6-.3-.6h-.2z"/></svg>
