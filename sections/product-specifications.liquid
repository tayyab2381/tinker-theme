{{ 'product-story-sections.css' | asset_url | stylesheet_tag }}

{% assign specification_content = product.metafields.custom.product_specifications %}
{% capture story_image %}
  {% render 'product-story-image', product: product, markers: '[gallery:detail],[gallery:feature]', index: 4, fallback_image: section.settings.image, class: 'product-story__image', sizes: '(min-width: 990px) 40vw, 100vw', loading: 'eager' %}
{% endcapture %}

{% if section.blocks.size > 0 or section.settings.show_defaults %}
  <section class="product-story-section product-story-section--specifications" style="--story-section-background: {{ section.settings.background_color }}; --story-radius: {{ section.settings.radius }}px; --story-padding-start: {{ section.settings.padding_top }}px; --story-padding-end: {{ section.settings.padding_bottom }}px;" {{ section.shopify_attributes }}>
    <div class="product-story-section__inner">
      <div class="product-story-specifications">
        <div>
          <header class="product-story-section__header">
            {% if section.settings.eyebrow != blank %}<p class="product-story-section__eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
            <h2 class="product-story-section__heading">{{ section.settings.heading }}</h2>
            {% if specification_content != blank %}
              <div class="product-story-section__intro">{{ specification_content | metafield_tag }}</div>
            {% elsif section.settings.intro != blank %}
              <div class="product-story-section__intro">{{ section.settings.intro }}</div>
            {% endif %}
          </header>
          <div class="product-story-section__image-frame">{{ story_image }}</div>
        </div>

        <div class="product-story-specifications__list">
          {% if section.blocks.size > 0 %}
            {% for block in section.blocks %}
              {% if block.settings.label != blank or block.settings.value != blank %}
                <div class="product-story-specification" {{ block.shopify_attributes }}>
                  <div class="product-story-specification__label">
                    {% if block.settings.icon != 'none' or block.settings.icon_image != blank %}
                      {% render 'icon-or-image', icon: block.settings.icon, image_upload: block.settings.icon_image, width: 18, class_name: 'product-story-specification__icon' %}
                    {% endif %}
                    {{ block.settings.label }}
                  </div>
                  <div class="product-story-specification__value">{{ block.settings.value }}</div>
                </div>
              {% endif %}
            {% endfor %}
          {% else %}
            {% assign specification_labels = 'Dimensions|Product weight|Cover material|Filling or foam|Cleaning|Recommended surface|Package contents' | split: '|' %}
            {% assign specification_values = 'Add product dimensions|Add product weight|Premium soft-touch cover|Purpose-built supportive fill|Spot clean as needed|Firm bed or stable surface|1 ergonomic support cushion' | split: '|' %}
            {% for specification_label in specification_labels %}
              <div class="product-story-specification">
                <div class="product-story-specification__label">{{ specification_label }}</div>
                <div class="product-story-specification__value">{{ specification_values[forloop.index0] }}</div>
              </div>
            {% endfor %}
          {% endif %}
        </div>
      </div>
    </div>
  </section>
{% endif %}

{% schema %}
{
  "name": "Product specifications",
  "tag": "section",
  "class": "product-story-wrapper",
  "max_blocks": 10,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Details that matter" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Made to fit beautifully into your routine" },
    { "type": "richtext", "id": "intro", "label": "Intro", "default": "<p>Clear details so you can choose with confidence.</p>" },
    { "type": "image_picker", "id": "image", "label": "Fallback image" },
    { "type": "checkbox", "id": "show_defaults", "label": "Show default specifications when no blocks are added", "default": true },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#ffffff" },
    { "type": "range", "id": "radius", "label": "Corner radius", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_top", "label": "Top spacing", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom spacing", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 96 }
  ],
  "blocks": [
    {
      "type": "specification",
      "name": "Specification",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "options": [
          { "value": "ruler", "label": "Ruler" },
          { "value": "box", "label": "Box" },
          { "value": "washing", "label": "Washing" },
          { "value": "none", "label": "None" }
        ], "default": "none" },
        { "type": "image_picker", "id": "icon_image", "label": "Optional icon image" },
        { "type": "text", "id": "label", "label": "Label", "default": "Dimensions" },
        { "type": "text", "id": "value", "label": "Value", "default": "Add product dimensions" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product specifications",
      "blocks": [
        { "type": "specification" },
        { "type": "specification", "settings": { "label": "Product weight", "value": "Add product weight" } },
        { "type": "specification", "settings": { "label": "Cover material", "value": "Premium soft-touch cover" } },
        { "type": "specification", "settings": { "label": "Filling or foam", "value": "Purpose-built supportive fill" } },
        { "type": "specification", "settings": { "label": "Cleaning", "value": "Spot clean as needed" } },
        { "type": "specification", "settings": { "label": "Recommended surface", "value": "Firm bed or stable surface" } },
        { "type": "specification", "settings": { "label": "Package contents", "value": "1 ergonomic support cushion" } }
      ]
    }
  ]
}
{% endschema %}
