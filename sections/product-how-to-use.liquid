{{ 'product-story-sections.css' | asset_url | stylesheet_tag }}

{% liquid
  assign how_to_use_content = product.metafields.custom.product_how_to_use
%}

{% if section.blocks.size > 0 or section.settings.show_defaults %}
  <section class="product-story-section product-story-section--steps" style="--story-section-background: {{ section.settings.background_color }}; --story-card-background: {{ section.settings.card_background_color }}; --story-radius: {{ section.settings.radius }}px; --story-padding-start: {{ section.settings.padding_top }}px; --story-padding-end: {{ section.settings.padding_bottom }}px;" {{ section.shopify_attributes }}>
    <div class="product-story-section__inner">
      <header class="product-story-section__header">
        {% if section.settings.eyebrow != blank %}<p class="product-story-section__eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
        <h2 class="product-story-section__heading">{{ section.settings.heading }}</h2>
        {% if how_to_use_content != blank %}
          <div class="product-story-section__intro">{{ how_to_use_content | metafield_tag }}</div>
        {% elsif section.settings.intro != blank %}
          <div class="product-story-section__intro">{{ section.settings.intro }}</div>
        {% endif %}
      </header>

      <div class="product-story-steps">
        {% if section.blocks.size > 0 %}
          {% for block in section.blocks %}
            {% if block.settings.heading != blank or block.settings.text != blank %}
              {% capture story_image %}
                {% render 'product-story-image', product: product, markers: '[gallery:lifestyle],[gallery:detail]', index: forloop.index0, fallback_image: block.settings.image, class: 'product-story__image', sizes: '(min-width: 990px) 33vw, 100vw', loading: 'eager' %}
              {% endcapture %}
              <article class="product-story-step" {{ block.shopify_attributes }}>
                <div class="product-story-step__image">{{ story_image }}</div>
                <div class="product-story-step__body">
                  <span class="product-story-step__number">{{ forloop.index }}</span>
                  {% if block.settings.heading != blank %}<h3 class="product-story-step__title">{{ block.settings.heading }}</h3>{% endif %}
                  {% if block.settings.text != blank %}<div class="product-story-step__text">{{ block.settings.text }}</div>{% endif %}
                </div>
              </article>
            {% endif %}
          {% endfor %}
        {% else %}
          {% assign step_titles = 'Place it on a stable surface|Position your body comfortably|Adjust until properly supported' | split: '|' %}
          {% assign step_texts = 'Set the cushion on a firm bed or surface before getting comfortable.|Use the raised shape beneath your upper body, hips, legs, or knees.|Make small adjustments until the position feels natural and supported.' | split: '|' %}
          {% for step_title in step_titles %}
            {% capture story_image %}
              {% render 'product-story-image', product: product, markers: '[gallery:lifestyle],[gallery:detail]', index: forloop.index0, class: 'product-story__image', sizes: '(min-width: 990px) 33vw, 100vw', loading: 'eager' %}
            {% endcapture %}
            <article class="product-story-step">
              <div class="product-story-step__image">{{ story_image }}</div>
              <div class="product-story-step__body">
                <span class="product-story-step__number">{{ forloop.index }}</span>
                <h3 class="product-story-step__title">{{ step_title }}</h3>
                <div class="product-story-step__text"><p>{{ step_texts[forloop.index0] }}</p></div>
              </div>
            </article>
          {% endfor %}
        {% endif %}
      </div>
    </div>
  </section>
{% endif %}

{% schema %}
{
  "name": "How to use it",
  "tag": "section",
  "class": "product-story-wrapper",
  "max_blocks": 3,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Simple from the start" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Settle in comfortably" },
    { "type": "richtext", "id": "intro", "label": "Intro", "default": "<p>A simple three-step ritual for finding the position that feels right for you.</p>" },
    { "type": "checkbox", "id": "show_defaults", "label": "Show default steps when no blocks are added", "default": true },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "card_background_color", "label": "Card background", "default": "#f8f4f1" },
    { "type": "range", "id": "radius", "label": "Corner radius", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_top", "label": "Top spacing", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom spacing", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 96 }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Usage step",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Place it on a stable surface" },
        { "type": "richtext", "id": "text", "label": "Description", "default": "<p>Set the cushion on a firm bed or surface before getting comfortable.</p>" },
        { "type": "image_picker", "id": "image", "label": "Fallback image" }
      ]
    }
  ],
  "presets": [
    {
      "name": "How to use it",
      "blocks": [
        { "type": "step" },
        { "type": "step", "settings": { "heading": "Position your body comfortably", "text": "<p>Use the raised shape beneath your upper body, hips, legs, or knees.</p>" } },
        { "type": "step", "settings": { "heading": "Adjust until properly supported", "text": "<p>Make small adjustments until the position feels natural and supported.</p>" } }
      ]
    }
  ]
}
{% endschema %}
