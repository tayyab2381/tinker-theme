{{ 'product-story-sections.css' | asset_url | stylesheet_tag }}

{% assign why_content = product.metafields.custom.product_why_choose %}
{% capture story_image %}
  {% render 'product-story-image',
    product: product,
    marker: '[gallery:feature]',
    index: 1,
    fallback_image: section.settings.image,
    alt: product.title,
    class: 'product-story__image',
    sizes: '(min-width: 990px) 45vw, 100vw',
    loading: 'eager',
    fetchpriority: 'auto'
  %}
{% endcapture %}

{% if section.blocks.size > 0 or section.settings.show_defaults %}
  <section class="product-story-section product-story-section--benefits" style="--story-section-background: {{ section.settings.background_color }}; --story-card-background: {{ section.settings.card_background_color }}; --story-radius: {{ section.settings.radius }}px; --story-padding-start: {{ section.settings.padding_top }}px; --story-padding-end: {{ section.settings.padding_bottom }}px;" {{ section.shopify_attributes }}>
    <div class="product-story-section__inner">
      <div class="product-story-benefits">
        <div class="product-story-benefits__media product-story-section__image-frame">
          {{ story_image }}
        </div>

        <div class="product-story-benefits__content">
          <header class="product-story-section__header">
            {% if section.settings.eyebrow != blank %}<p class="product-story-section__eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
            <h2 class="product-story-section__heading">{{ section.settings.heading }}</h2>
            {% if why_content != blank %}
              <div class="product-story-section__intro">{{ why_content | metafield_tag }}</div>
            {% elsif section.settings.intro != blank %}
              <div class="product-story-section__intro">{{ section.settings.intro }}</div>
            {% endif %}
          </header>

          <div class="product-story-benefits__cards">
            {% if section.blocks.size > 0 %}
              {% for block in section.blocks %}
                {% if block.settings.title != blank or block.settings.text != blank %}
                  <article class="product-story-card" {{ block.shopify_attributes }}>
                    {% if block.settings.icon != 'none' or block.settings.icon_image != blank %}
                      <div class="product-story-card__icon">
                        {% render 'icon-or-image', icon: block.settings.icon, image_upload: block.settings.icon_image, width: 28, class_name: 'product-story-card__icon-media' %}
                      </div>
                    {% endif %}
                    {% if block.settings.title != blank %}<h3 class="product-story-card__title">{{ block.settings.title }}</h3>{% endif %}
                    {% if block.settings.text != blank %}<div class="product-story-card__text">{{ block.settings.text }}</div>{% endif %}
                  </article>
                {% endif %}
              {% endfor %}
            {% else %}
              {% assign benefit_titles = 'Ergonomic body support|Comfortable elevated positioning|Premium soft-touch cover|Stable, purpose-built shape' | split: '|' %}
              {% assign benefit_texts = 'A sculpted profile helps you settle into a relaxed position.|Designed to support everyday reclining, reading, and unwinding.|A soft, refined finish feels at home in a modern bedroom.|A broad base helps the cushion stay steady where you place it.' | split: '|' %}
              {% assign benefit_icons = 'heart|plant|star|box' | split: '|' %}
              {% for benefit_title in benefit_titles %}
                <article class="product-story-card">
                  <div class="product-story-card__icon">
                    <svg class="product-story-card__icon-media" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 20 20">
                      {% render 'icon', icon: benefit_icons[forloop.index0] %}
                    </svg>
                  </div>
                  <h3 class="product-story-card__title">{{ benefit_title }}</h3>
                  <div class="product-story-card__text"><p>{{ benefit_texts[forloop.index0] }}</p></div>
                </article>
              {% endfor %}
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  </section>
{% endif %}

{% schema %}
{
  "name": "Why customers choose it",
  "tag": "section",
  "class": "product-story-wrapper",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Thoughtfully designed" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Comfort that feels considered" },
    { "type": "richtext", "id": "intro", "label": "Intro", "default": "<p>Made for slow mornings, relaxed evenings, and the small moments when better support makes a difference.</p>" },
    { "type": "image_picker", "id": "image", "label": "Fallback image" },
    { "type": "checkbox", "id": "show_defaults", "label": "Show default benefits when no blocks are added", "default": true },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "card_background_color", "label": "Card background", "default": "#f8f4f1" },
    { "type": "range", "id": "radius", "label": "Corner radius", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 20 },
    { "type": "range", "id": "padding_top", "label": "Top spacing", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom spacing", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 96 }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "options": [
          { "value": "heart", "label": "Heart" },
          { "value": "plant", "label": "Plant" },
          { "value": "star", "label": "Star" },
          { "value": "box", "label": "Box" },
          { "value": "info", "label": "Info" },
          { "value": "none", "label": "None" }
        ], "default": "heart" },
        { "type": "image_picker", "id": "icon_image", "label": "Optional icon image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Ergonomic body support" },
        { "type": "richtext", "id": "text", "label": "Description", "default": "<p>A sculpted profile helps you settle into a relaxed position.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Why customers choose it",
      "blocks": [
        { "type": "benefit" },
        { "type": "benefit", "settings": { "icon": "plant", "title": "Comfortable elevated positioning", "text": "<p>Designed to support everyday reclining, reading, and unwinding.</p>" } },
        { "type": "benefit", "settings": { "icon": "star", "title": "Premium soft-touch cover", "text": "<p>A soft, refined finish feels at home in a modern bedroom.</p>" } },
        { "type": "benefit", "settings": { "icon": "box", "title": "Stable, purpose-built shape", "text": "<p>A broad base helps the cushion stay steady where you place it.</p>" } }
      ]
    }
  ]
}
{% endschema %}
